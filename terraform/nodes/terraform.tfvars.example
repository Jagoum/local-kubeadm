# Terraform variables example file for Nodes layer
# Copy this file to terraform.tfvars and customize

# VM Configuration
control_plane_name = "k8s-control-plane"
worker_names       = ["k8s-worker-1", "k8s-worker-2"]

# Incus Configuration
# Image supports cloud-init: images:ubuntu/24.04/cloud
ubuntu_image  = "images:ubuntu/24.04/cloud"
incus_network = "incusbr0"
incus_pool    = "default"

# SSH and User Configuration
# Generate a key: ssh-keygen -t rsa -b 4096 -f ~/.ssh/k8s_cluster_key
ssh_public_key = ""

# Password for the 'ubuntu' user (used for console access)
node_password = "ubuntu-password-here"
