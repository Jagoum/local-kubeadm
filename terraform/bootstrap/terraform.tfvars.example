# Terraform Bootstrap Configuration Example
# Copy this file to terraform.tfvars and customize for your environment

# Node configuration
control_plane_name = "k8s-control-plane"
worker_names       = ["k8s-worker-1", "k8s-worker-2"]

# Kubernetes configuration
kubernetes_version = "1.34"
calico_version     = "3.31.4"
pod_network_cidr   = "10.244.0.0/16"
service_cidr       = "10.96.0.0/12"

# GitOps configuration (Source of Truth)
gitops_repo_url        = "https://github.com/skyengpro/openstack-deployment.git"
gitops_target_revision = "feat/deploy-neutron-agent-on-bare-metal-using-containers"

# GitHub Personal Access Token (PAT) for private repository authentication
# Leave empty for public repositories
# For private repos, generate a PAT with 'repo' scope at:
# https://github.com/settings/tokens
github_pat = ""
