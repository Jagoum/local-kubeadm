# Terraform variables example file
# Copy this file to terraform.tfvars and customize
# Updated for 2026 - using LTS versions

# VM Configuration
control_plane_name = "k8s-control-plane"
worker_names       = ["k8s-worker-1", "k8s-worker-2"]

# Ubuntu image (24.04 LTS)
ubuntu_image = "24.04"

# SSH public key (optional - leave empty for default)
# Add your SSH public key here for secure access
ssh_public_key = ""

# Kubernetes version (LTS versions available: 1.31, 1.32, 1.33, 1.34, 1.35)
# 1.31 LTS recommended for production (supported until Oct 2025)
kubernetes_version = "1.31"

# Calico CNI version (3.31.4 LTS - use full version for URL)
# 3.31 LTS recommended for production (supported until Apr 2026)
calico_version = "3.31.4"

# Network configuration
# Pod CIDR: 10.244.0.0/16 (safe for Multipass - avoids 10.253.137.0/24)
# Service CIDR: 10.96.0.0/12 (safe for Multipass)
pod_network_cidr = "10.244.0.0/16"
service_cidr     = "10.96.0.0/12"